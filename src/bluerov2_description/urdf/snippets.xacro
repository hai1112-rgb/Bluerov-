<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="thruster_macro" params="thruster_id xyz rpy">
    <joint name="thruster_${thruster_id}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="thruster_${thruster_id}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="thruster_${thruster_id}">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="file://$(find bluerov2_description)/meshes/bluerov2_propcw.dae" scale="1 1 1"/>
        </geometry>
      </visual>
    </link>
  </xacro:macro>
</robot>
