    <!-- ==================== FISH: Gazebo-native trajectory followers ==================== -->
    <!-- Each fish has its own small patrol path so motion is visible without a ROS-side pose consumer. -->

    <model name="fish_0">
      <static>false</static>
      <pose>5 3 -195 0 0 0</pose>
      <link name="body">
        <inertial><mass>0.2</mass></inertial>
